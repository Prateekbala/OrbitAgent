    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@node-saml/node-saml": "^5.1.0",
    "@vercel/sandbox": "3.6.1",
    "ai": "^7.0.150",
    "cron-parser": "^5.10.2",
