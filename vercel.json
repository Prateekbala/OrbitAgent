{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm run vercel:install",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm run vercel:install",
      "functions": {
        "src/vercel.ts": {
          "maxDuration": 300,
          "regions": ["bom1"]
        }
      },
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "/:path*"
        }
      ]
    },
    "worker": {
      "root": "apps/background",
      "installCommand": "cd ../.. && npm run vercel:install",
      "functions": {
        "api/worker.ts": {
          "maxDuration": 300,
          "regions": ["bom1"],
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "orbit-background-v1",
              "retryAfterSeconds": 30,
              "maxConcurrency": 2
            }
          ]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/internal/:path*",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web"
      }
    }
  ]
}
